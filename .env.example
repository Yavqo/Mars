# Turso (libSQL). Mars keeps its index here. Create a token with: turso db tokens create <database>
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=
# For tests, a local file works without a token: TURSO_DATABASE_URL=file:local.db
# Only needed once, for `npm run migrate:neon` (copies the old Postgres data into Turso).
# NEON_DATABASE_URL=

# AI overview (optional). Get a key at https://openrouter.ai/keys. Without it the overview card simply does not appear.
# Mars sends the search words and short excerpts of the top results to OpenRouter to write the overview.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=minimax/minimax-m3.1-flash:free
# The overview's system prompt. Edit prompts.txt to change how it writes.
# OVERVIEW_PROMPTS_FILE=prompts.txt

# "Who's in this photo?" on person-card photos (optional). Get a key at https://aistudio.google.com/apikey.
# Without it the button does not appear. The photo, and the portraits of up to 12 saved people to match faces against,
# are sent to Google's Gemini API.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# YavqoBot, the crawler. A URL or email site owners can use to reach you; added to its user agent.
# CRAWLER_CONTACT=https://example.com/bot
# On Vercel, YavqoBot runs through /api/cron/crawl. Any long random string; Vercel's cron sends it, and calls without it are refused.
CRON_SECRET=

# Crawler throughput. One worker process keeps this many sites active at once.
WORKER_CONCURRENCY=6
WORKER_PAGES_PER_SITE=60
WORKER_DEPTH=3
WORKER_PAUSE_SECONDS=0
# Page tasks per crawl; requests still share a host limit of two and paced starts.
CRAWLER_CONCURRENCY=4
CRAWLER_DELAY_MS=1000

# Password for /crawl and /admin/people. Set it in Vercel (Project Settings > Environment Variables).
# Without it, the admin only opens on localhost.
ADMIN_PASSWORD=
